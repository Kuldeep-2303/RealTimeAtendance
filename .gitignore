# --- OS ---
.DS_Store
Thumbs.db

# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/

# Pytest/cache
.pytest_cache/

# mypy
.mypy_cache/

# coverage
.coverage
coverage.xml
htmlcov/

# PyCharm
.idea/

# Django stuff:
# local SQLite DB
*.sqlite3
*.db

# Flask instance folder
instance/

# Alembic / migrations (keep source but ignore compiled cache)
alembic/versions/__pycache__/

# --- Node / Frontend ---
frontend/node_modules/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# If you use environment files in the frontend
frontend/.env
frontend/.env.*

# If you have a top-level package-lock but don't want to ignore it by default,
# keep it tracked; uncomment to ignore it.
# package-lock.json

# --- Project upload / data folders ---
# store known face images and uploaded photos outside of the repo
known_faces/
uploaded_images/

# --- Secrets / env files ---
.env
.env.*

# --- Logs and runtime files ---
*.log
logs/
*.pid
*.seed

# --- Editor / IDE ---
.vscode/
*.swp
*.swo
.history/

# --- Misc ---
# macOS metadata
._*

# End of .gitignore

# Node / JS
node_modules/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Environment
.env

